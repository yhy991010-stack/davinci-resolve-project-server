# 复制为 .env 后再修改。不要把填好密码的 .env 提交到 Git。

# 时区（PostgreSQL 日志和内部时间）
TZ=Asia/Shanghai

# 达芬奇连接数据库时使用的账号，请改成你自己的
POSTGRES_USER=resolve
POSTGRES_PASSWORD=change-me-to-a-strong-password

# 数据目录（相对本仓库，或改成 NAS 上的绝对路径）
DATA_DIR=./data

# ---------- 方式 A：普通 Docker，宿主机 5432 空闲时用 ----------
# 无需再填下面的网卡参数。

# ---------- 方式 B：绿联等系统已经占用了 5432 时用 macvlan ----------
# 网卡名在 NAS 上用 `ip -br addr` 查看，常见为 eth0 或 ens*.
LAN_PARENT=eth0
LAN_SUBNET=192.168.1.0/24
LAN_GATEWAY=192.168.1.1

# 给达芬奇数据库独占的局域网地址，必须是网段里未被占用的 IP
DB_IP=192.168.1.20

# ---------- 方式 C：还要经 Tailscale 远程访问时，再加一层转发 ----------
# 再选一个未被占用的局域网 IP，给转发容器监听（局域网和 Tailscale 子网路由都走它）
SHIM_IP=192.168.1.21

# NAS 的 Tailscale 地址，例如 100.x.y.z；没有就留空
TAILSCALE_IP=
